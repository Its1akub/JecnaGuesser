{% extends 'base.html.twig' %}

{% block title %}Game Finish{% endblock %}

{% block body %}
<div class="finish-container">
    <h1 class="title-name">Game Finished!</h1>

    <div class="stats-box">
        <p><strong>Difficulty:</strong> {{ difficulty|capitalize }}</p>
        <p><strong>Time:</strong> {{ time }} seconds</p>
        <p><strong>Score:</strong> {{ score }} pts</p>
    </div>

    <form action="{{ path('game_save') }}" method="POST" class="save-score-form">
        <label for="playerName">Enter your name for the leaderboard:</label>
        <input type="text" id="playerName" name="playerName" required maxlength="100" placeholder="e.g. GeoMaster99">

        <button type="submit" class="submit-btn">Save Score</button>
    </form>

    <br>
    <a href="{{ path('app_home') }}" class="diff-btn">Home</a>
</div>
{% endblock %}
