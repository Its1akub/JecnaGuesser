{% extends 'base.html.twig' %}

{% block title %}Game Finish{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/postgame.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}

<h1>Game Finished</h1>

<div class="stats-container">
    <div>
        <p class="nav-element-info score-highlight"> {{ score }} pts</p>
        <p class="nav-element-header">SCORE</p>
    </div>

    <div>
        <p class="nav-element-info"> {{ time }} seconds</p>
        <p class="nav-element-header">TIME</p>
    </div>

    <div>
        <p class="nav-element-info"> {{ difficulty|capitalize }} </p>
        <p class="nav-element-header">DIFFICULTY</p>
    </div>
</div>

<form action="{{ path('game_save') }}" method="POST" class="save-score-form">
    <input type="text" id="playerName" name="playerName" required maxlength="100" placeholder="Username" class="name-input">

    <button type="submit" class="play-btn">UPLOAD</button>
    <a href="{{ path('app_home') }}" class="diff-btn">Home</a>
</form>

<br>

{% endblock %}
