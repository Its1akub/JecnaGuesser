{% extends 'base.html.twig' %}

{% block title %} {{ difficulty }} Game{% endblock %}

{% block body %}

<div id="main-content" onclick="closeMap()">
    <div class="game-navbar">
        <div>
            <p class="nav-element-info"><span id="round-counter">1</span>/5</p>
            <p class="nav-element-header">ROUND</p>
        </div>

        <div>
            <p class="nav-element-info" id="score-counter">0</p>
            <p class="nav-element-header">SCORE</p>
        </div>

        <div>
            <div {{ stimulus_controller('countup', {
                start: date('c')
            }) }}>
                <p class="nav-element-info"><span {{ stimulus_target('countup', 'display') }}>0s</span></p>
            </div>
            <p class="nav-element-header">TIME</p>
        </div>
    </div>


    <div class="location-container">
        <img src="{{ asset('test.png') }}" class="location-image">
    </div>
</div>


<div class="map-container" id="mapContainer">
    <div class="handle-container" onclick="document.getElementById('mapContainer').classList.toggle('expanded')">
        <div class="handle-bar"></div>
    </div>

    <div class="map-wrapper" id="mapWrapper">
        <div class="image-container" id="imageContainer" onclick="placePin(event)">
            <img src="{{ asset('map.png') }}" class="map-image">
            <div id="mapPin" class="map-pin"></div>
        </div>
    </div>

    <button id="guessBtn" class="guess-button" onclick="submitGuess()" disabled>GUESS</button>
</div>

{% block javascripts %}
      {{ parent() }}
      {{ encore_entry_script_tags('app.js') }}
      <script>
      function closeMap() {
          const map = document.getElementById('mapContainer');
          if (map.classList.contains('expanded')) {
              map.classList.remove('expanded');
          }
      }

      let currentGuessX = null;
      let currentGuessY = null;

      function placePin(event) {
          const container = document.getElementById('imageContainer');
          const rect = container.getBoundingClientRect();

          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;

          currentGuessX = (x / rect.width) * 100;
          currentGuessY = (y / rect.height) * 100;

          const pin = document.getElementById('mapPin');
          pin.style.left = `${currentGuessX}%`;
          pin.style.top = `${currentGuessY}%`;
          pin.style.display = 'block';

          document.getElementById('guessBtn').disabled = false;
      }

      function submitGuess() {
          const mapContainer = document.getElementById('mapContainer');
          const pin = document.getElementById('mapPin');
          const guessBtn = document.getElementById('guessBtn');
          const mapWrapper = document.getElementById('mapWrapper');

          if (currentGuessX === null || currentGuessY === null) return;

          guessBtn.disabled = true;
          guessBtn.innerText = "GUESSING...";

          const params = new URLSearchParams();
          params.append('x', currentGuessX);
          params.append('y', currentGuessY);

          fetch("{{ path('game_guess') }}", {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: params
          })
          .then(async response => {
              // Check if the response is actually JSON
              const contentType = response.headers.get("content-type");
              if (!contentType || !contentType.includes("application/json")) {
                  // If we got HTML/Text instead of JSON, something went wrong on the server
                  const text = await response.text();
                  console.error("Server returned non-JSON:", text);
                  throw new TypeError("Oops, the server didn't send JSON!");
              }
              return response.json();
          })
          .then(data => {
              // Check if the game is over
              if (data.is_finished) {
                  window.location.href = data.redirect_url;
                  return;
              }

              //alert(`Round Points: ${data.points}\nTotal Score: ${data.total_score}`);
              document.getElementById('round-counter').innerText = data.next_round;
              document.getElementById('score-counter').innerText = data.total_score;

              // Reset UI
              pin.style.display = 'none';
              guessBtn.innerText = "GUESS";
              currentGuessX = null;
              currentGuessY = null;
              closeMap();
          })
          .catch(error => {
              console.error('Error:', error);
              alert("There was an error processing your guess. Check the console.");
              guessBtn.disabled = false;
              guessBtn.innerText = "GUESS";
          });
      }
      </script>
{% endblock %}

{% endblock %}
