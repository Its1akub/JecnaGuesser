{% extends 'base.html.twig' %}

{% block title %} {{ difficulty }} Game{% endblock %}

{% block body %}

<div id="main-content" onclick="closeMap()">
    <div class="game-navbar">
        <div>
            <p class="nav-element-info"><span id="roundCounter">1</span>/5</p>
            <p class="nav-element-header">ROUND</p>
        </div>

        <div>
            <p class="nav-element-info" id="scoreCounter">0</p>
            <p class="nav-element-header">SCORE</p>
        </div>

        <div>
            <div {{ stimulus_controller('countup', {
                start: date('c')
            }) }}>
                <p class="nav-element-info"><span {{ stimulus_target('countup', 'display') }}>0s</span></p>
            </div>
            <p class="nav-element-header">TIME</p>
        </div>
    </div>


    <div class="location-container">
        <img src="{{ asset('test.png') }}" class="location-image">
    </div>
</div>


<div class="map-container" id="mapContainer">
    <div class="handle-container" onclick="document.getElementById('mapContainer').classList.toggle('expanded')">
        <div class="handle-bar"></div>
    </div>

    <div class="map-wrapper" id="mapWrapper">
        <div class="image-container" id="imageContainer" onclick="placePin(event)">
            <img src="{{ asset('map.png') }}" class="map-image">
            <div id="mapPin" class="map-pin"></div>

            <div id="actualPin" class="actual-pin"></div>
            <div id="distanceLine" class="distance-line"></div>
        </div>
    </div>

    <p id="guessPointsCointainer" class="guess-points"><span id="guessPoints">0</span> pts</p>
    <button id="guessBtn" class="guess-button" onclick="submitGuess()" disabled>GUESS</button>
</div>

{% block javascripts %}
      {{ parent() }}
      {{ encore_entry_script_tags('app.js') }}
      <script>
      function closeMap() {
          const map = document.getElementById('mapContainer');
          if (map.classList.contains('expanded')) {
              map.classList.remove('expanded');
          }
      }

      let currentGuessX = null;
      let currentGuessY = null;
      let roundOver = false;

      function placePin(event) {
          if (roundOver) return;

          const container = document.getElementById('imageContainer');
          const rect = container.getBoundingClientRect();

          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;

          currentGuessX = (x / rect.width) * 100;
          currentGuessY = (y / rect.height) * 100;

          const pin = document.getElementById('mapPin');
          pin.style.left = `${currentGuessX}%`;
          pin.style.top = `${currentGuessY}%`;
          pin.style.display = 'block';

          document.getElementById('guessBtn').disabled = false;
      }

      function submitGuess() {
          if (roundOver) {
              reset();
              return;
          }

          const mapContainer = document.getElementById('mapContainer');
          const pin = document.getElementById('mapPin');
          const guessBtn = document.getElementById('guessBtn');
          const mapWrapper = document.getElementById('mapWrapper');

          if (currentGuessX === null || currentGuessY === null) return;

          guessBtn.disabled = true;
          guessBtn.innerText = "GUESSING...";

          const params = new URLSearchParams();
          params.append('x', currentGuessX);
          params.append('y', currentGuessY);

          fetch("{{ path('game_guess') }}", {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: params
          })
          .then(response => response.json())
          .then(data => {
              if (data.is_finished) {
                  window.location.href = data.redirect_url;
                  return;
              }

              document.getElementById('roundCounter').innerText = data.next_round;
              document.getElementById('scoreCounter').innerText = data.total_score;
              document.getElementById('guessPointsCointainer').style.display = 'block';
              document.getElementById('guessPoints').innerText = data.points;

              const actualPin = document.getElementById('actualPin');
              actualPin.style.left = `${data.actual_x}%`;
              actualPin.style.top = `${data.actual_y}%`;
              actualPin.style.display = 'block';

              drawLine(currentGuessX, currentGuessY, data.actual_x, data.actual_y);

              guessBtn.disabled = false;
              guessBtn.innerText = "NEXT";

              roundOver = true;
          })
          .catch(error => {
              console.error('Error:', error);
              guessBtn.disabled = false;
              guessBtn.innerText = "GUESS";
          });
      }

      function reset() {
          const pin = document.getElementById('mapPin');
          const actualPin = document.getElementById('actualPin');
          const line = document.getElementById('distanceLine');
          const guessBtn = document.getElementById('guessBtn');

          roundOver = false;

          pin.style.display = 'none';
          actualPin.style.display = 'none';
          line.style.display = 'none';
          document.getElementById('guessPointsCointainer').style.display = 'none';

          guessBtn.disabled = true;
          guessBtn.innerText = "GUESS";
          currentGuessX = null;
          currentGuessY = null;
          closeMap();
      }


      function drawLine(x1Pct, y1Pct, x2Pct, y2Pct) {
          const container = document.getElementById('imageContainer');
          const rect = container.getBoundingClientRect();
          const line = document.getElementById('distanceLine');

          const x1 = (x1Pct / 100) * rect.width;
          const y1 = (y1Pct / 100) * rect.height;
          const x2 = (x2Pct / 100) * rect.width;
          const y2 = (y2Pct / 100) * rect.height;

          const length = Math.hypot(x2 - x1, y2 - y1);
          const angle = Math.atan2(y2 - y1, x2 - x1) * (180 / Math.PI);

          line.style.left = `${x1Pct}%`;
          line.style.top = `${y1Pct}%`;
          line.style.width = `${length}px`;
          line.style.transform = `translateY(-50%) rotate(${angle}deg)`;
          line.style.display = 'block';
      }
      </script>
{% endblock %}

{% endblock %}
