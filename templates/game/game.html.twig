{% extends 'base.html.twig' %}

{% block title %}Game{% endblock %}

{% block body %}
<h1>Game</h1>
<h2>{{ difficulty }}</h2>

<div {{ stimulus_controller('countup', {
    start: date('c')
}) }} class="blurred-div">
    <p>Time elapsed: <span {{ stimulus_target('countup', 'display') }}>0s</span></p>
</div>

<a href="{{ path('app_home') }}" class="diff-btn">Home</a>

{% endblock %}
