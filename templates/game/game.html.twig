{% extends 'base.html.twig' %}

{% block title %} {{ difficulty }} Game{% endblock %}

{% block body %}

<div id="main-content" onclick="closeMap()">
    <div class="game-navbar">
        <div>
            <p class="nav-element-info"><span id="roundCounter">1</span>/5</p>
            <p class="nav-element-header">ROUND</p>
        </div>

        <div>
            <p class="nav-element-info" id="scoreCounter">0</p>
            <p class="nav-element-header">SCORE</p>
        </div>

        <div>
            <div {{ stimulus_controller('countup') }}
                data-action="game:pause@window->countup#pause game:resume@window->countup#resume game:sync-time@window->countup#sync">
                <p class="nav-element-info">
                    <span {{ stimulus_target('countup', 'display') }}>0s</span>
                </p>
            </div>
            <p class="nav-element-header">TIME</p>
        </div>

        <div class="home-wrapper">
            <a href="{{ path('app_home') }}" class="home-btn"><img src="{{ asset('home.svg') }}" alt="Home" class="home-icon"/></a>
        </div>

    </div>


    <div class="location-container">
        <img src="{{ asset('locations/' ~ location_path) }}" class="location-image" id="locationImage">
    </div>
</div>


<div class="map-container" id="mapContainer">
    <div class="handle-container" onclick="document.getElementById('mapContainer').classList.toggle('expanded')">
        <div class="chevron-container">
            <div class="chevron"></div>
        </div>
    </div>

    <div class="floor-selector" id="floorSelector">
        <button id="floor0" class="floor-btn active" onclick="changeFloor(0, this)">0</button>
        <button id="floor1" class="floor-btn" onclick="changeFloor(1, this)">1</button>
        <button id="floor2" class="floor-btn" onclick="changeFloor(2, this)">2</button>
        <button id="floor3" class="floor-btn" onclick="changeFloor(3, this)">3</button>
        <button id="floor4" class="floor-btn" onclick="changeFloor(4, this)">4</button>
    </div>

    <div class="map-wrapper" id="mapWrapper">
        <div class="image-container" id="imageContainer" onclick="placePin(event)">
            <img src="{{ asset('maps/np1.webp') }}" class="map-image" id="mapImage">
            <div id="mapPin" class="map-pin"></div>

            <div id="actualPin" class="actual-pin"></div>
            <div id="distanceLine" class="distance-line"></div>
        </div>
    </div>

    <p id="guessPointsCointainer" class="guess-points-cointainer"><span id="guessPoints" class="guess-points">0</span> pts</p>
    <button id="guessBtn" class="guess-button" onclick="submitGuess()" disabled>GUESS</button>
</div>

{% block javascripts %}
      {{ parent() }}
      {{ encore_entry_script_tags('app.js') }}
      <script>
      function closeMap() {
          const map = document.getElementById('mapContainer');
          if (map.classList.contains('expanded')) {
              map.classList.remove('expanded');
          }
      }

      let currentGuessX = null;
      let currentGuessY = null;
      let currentFloor = 0;

      let roundOver = false;
      let finished = null;
      let submitResponse = null;

      function placePin(event) {
          if (roundOver) return;

          const container = document.getElementById('imageContainer');
          const rect = container.getBoundingClientRect();

          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;

          currentGuessX = (x / rect.width) * 100;
          currentGuessY = (y / rect.height) * 100;

          const pin = document.getElementById('mapPin');
          pin.style.left = `${currentGuessX}%`;
          pin.style.top = `${currentGuessY}%`;
          pin.style.display = 'block';

          document.getElementById('guessBtn').disabled = false;
      }

      function submitGuess() {
          if (roundOver) {
              if (submitResponse.is_finished) {
                window.location.href = submitResponse.redirect_url;
                return;
              }
              window.dispatchEvent(new CustomEvent('game:resume'));
              reset();
              return;
          }

          const mapContainer = document.getElementById('mapContainer');
          const pin = document.getElementById('mapPin');
          const guessBtn = document.getElementById('guessBtn');
          const mapWrapper = document.getElementById('mapWrapper');

          if (currentGuessX === null || currentGuessY === null) return;

          guessBtn.disabled = true;
          guessBtn.innerText = "GUESSING...";

          const params = new URLSearchParams();
          params.append('x', currentGuessX);
          params.append('y', currentGuessY);
          params.append('floor', currentFloor);

          //console.log(`(${currentGuessX}, ${currentGuessY}, ${currentFloor}, 'easy/loc7.webp', 'easy'),`)

          fetch("{{ path('game_guess') }}", {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: params
          })
          .then(response => response.json())
          .then(data => {
              submitResponse = data;

              window.dispatchEvent(new CustomEvent('game:pause'));
              window.dispatchEvent(new CustomEvent('game:sync-time', {
                  detail: { seconds: data.total_time }
              }));

              document.getElementById('guessPointsCointainer').style.display = 'block';
              document.getElementById('guessPoints').innerText = data.points;
              document.getElementById('mapContainer').classList.add('guessed');

              const actualPin = document.getElementById('actualPin');
              actualPin.style.left = `${data.actual_x}%`;
              actualPin.style.top = `${data.actual_y}%`;
              actualPin.style.display = 'block';

              drawLine(currentGuessX, currentGuessY, data.actual_x, data.actual_y);

              guessBtn.disabled = false;
              guessBtn.innerText = data.is_finished ? "FINISH" : "NEXT";

              document.getElementById(`floor${data.actual_floor}`).classList.add('correct-floor');

              roundOver = true;
          })
          .catch(error => {
              console.error('Error:', error);
              guessBtn.disabled = false;
              guessBtn.innerText = "GUESS";
          });
      }

      function reset() {
          const pin = document.getElementById('mapPin');
          const actualPin = document.getElementById('actualPin');
          const line = document.getElementById('distanceLine');
          const guessBtn = document.getElementById('guessBtn');

          roundOver = false;

          pin.style.display = 'none';
          actualPin.style.display = 'none';
          line.style.display = 'none';
          document.getElementById('guessPointsCointainer').style.display = 'none';

          document.getElementById('mapContainer').classList.remove('guessed');

          guessBtn.disabled = true;
          guessBtn.innerText = "GUESS";
          currentGuessX = null;
          currentGuessY = null;
          closeMap();

          if (submitResponse == null || submitResponse.is_finished) return;
          document.getElementById('roundCounter').innerText = submitResponse.next_round + 1;
          document.getElementById('scoreCounter').innerText = submitResponse.total_score;

          document.getElementById(`floor${submitResponse.actual_floor}`).classList.remove('correct-floor');

          const locImg = document.getElementById('locationImage');
          locImg.src = `/locations/${submitResponse.next_location_path}`;


          fetch("{{ path('game_resume_timer') }}", {
              method: 'POST'
          });
      }

      function drawLine(x1Pct, y1Pct, x2Pct, y2Pct) {
          const container = document.getElementById('imageContainer');
          const rect = container.getBoundingClientRect();
          const line = document.getElementById('distanceLine');

          const x1 = (x1Pct / 100) * rect.width;
          const y1 = (y1Pct / 100) * rect.height;
          const x2 = (x2Pct / 100) * rect.width;
          const y2 = (y2Pct / 100) * rect.height;

          const length = Math.hypot(x2 - x1, y2 - y1);
          const angle = Math.atan2(y2 - y1, x2 - x1) * (180 / Math.PI);

          line.style.left = `${x1Pct}%`;
          line.style.top = `${y1Pct}%`;
          line.style.width = `${length}px`;
          line.style.transform = `translateY(-50%) rotate(${angle}deg)`;
          line.style.display = 'block';
      }


      function changeFloor(floorNum, buttonElement) {
          if (roundOver) return;

          currentFloor = floorNum;

          const img = document.getElementById('mapImage');
          img.src = `/maps/np${floorNum + 1}.webp`;

          document.querySelectorAll('.floor-btn').forEach(btn => {
              btn.classList.remove('active');
          });
          buttonElement.classList.add('active');

          const pin = document.getElementById('mapPin');
          pin.style.display = 'none';
          currentGuessX = null;
          currentGuessY = null;

          document.getElementById('guessBtn').disabled = true;
      }

      window.addEventListener('beforeunload',
          function (e) {
              if (submitResponse != null && submitResponse.is_finished) return;
              e.preventDefault();
              e.returnValue = '';
          });
      </script>
{% endblock %}

{% endblock %}
