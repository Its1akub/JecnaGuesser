{% extends 'base.html.twig' %}

{% block title %}Leaderboard {{ difficulty|capitalize }}{% endblock %}

{% block body %}

<div class="leaderboard-bar">
    <h1 class="leaderboard-title">Leaderboard</h1>

    <div class="filter-group">
        <a href="{{ path('app_leaderboard', {difficulty: 'easy'}) }}"
           class="filter-button {{ difficulty == 'easy' ? 'active' : '' }}">Easy</a>
        <a href="{{ path('app_leaderboard', {difficulty: 'medium'}) }}"
           class="filter-button {{ difficulty == 'medium' ? 'active' : '' }}">Medium</a>
        <a href="{{ path('app_leaderboard', {difficulty: 'hard'}) }}"
           class="filter-button {{ difficulty == 'hard' ? 'active' : '' }}">Hard</a>
    </div>

    <div class="toggle-container">
        <a href="{{ path('app_leaderboard', {difficulty: difficulty, unique: isUnique ? 0 : 1}) }}"
           class="toggle-btn {{ isUnique ? 'toggle-active' : '' }}">
            <span class="icon">{{ isUnique ? '✓' : '○' }}</span> Best per Name
        </a>
    </div>
</div>

<a href="{{ path('app_home') }}" class="diff-btn">Home</a>

<table class="leaderboard-table">
    <thead>
        <tr>
            <th class="no-wrap">Rank</th>
            <th class="no-wrap">Player</th>
            <th class="no-wrap">Score</th>
            <th class="no-wrap">Time</th>
            <th class="no-wrap">Date</th>
        </tr>
    </thead>
    <tbody>
        {% for score in scores %}
            <tr class="rank-{{ loop.index }} no-wrap">
                <td>{% if loop.index == 1 %}🥇{% elseif loop.index == 2 %}🥈{% elseif loop.index == 3 %}🥉{% else %}{{ loop.index }}{% endif %}</td>
                <td><strong>{{ score.playerName }}</strong></td>
                <td class="no-wrap" >{{ score.score|number_format }}</td>
                <td>{{ score.time }}s</td>
                <td>{{ score.playedAt|date('j/n/y') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" style="text-align:center;">No scores found for this difficulty.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}
