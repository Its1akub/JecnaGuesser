{% extends 'base.html.twig' %}

{% block title %}Leaderboard{% endblock %}

{% block body %}
<div class="leaderboard-container">
    <h1 class="title-name">Leaderboard</h1>

    <table class="leaderboard-table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Player</th>
                <th>Score</th>
                <th>Time</th>
                <th>Difficulty</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for score in scores %}
                <tr class="rank-{{ loop.index }}">
                    <td>
                        {% if loop.index == 1 %}🥇{% elseif loop.index == 2 %}🥈{% elseif loop.index == 3 %}🥉{% else %}{{ loop.index }}{% endif %}
                    </td>
                    <td><strong>{{ score.playerName }}</strong></td>
                    <td>{{ score.score|number_format }} pts</td>
                    <td>{{ score.time }}s</td>
                    <td><span class="badge-{{ score.difficulty|lower }}">{{ score.difficulty|capitalize }}</span></td>
                    <td>{{ score.playedAt|date('d/m/Y') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No scores yet. Be the first!</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_home') }}" class="diff-btn">Home</a>
</div>
{% endblock %}
