<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        <meta name="description" content="From a picture, guess where you are in SPŠE Ječná.">
        <meta name="keywords" content="SPŠE, Ječná, geoguesser, geoguessr, guesser">
        <title>{% block title %}{% endblock %} - Ječná Guesser</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Google+Sans:opsz,wght@17..18,400..700&display=swap" rel="stylesheet">
        <link rel="icon" href="{{ asset('jg_logo_large.svg') }}">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body>
        <div class="main">
            {% block body %}{% endblock %}
        </div>
    </body>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</html>
