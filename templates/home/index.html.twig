{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<img src="{{ asset('jg_logo_large.svg') }}" alt="Logo" class="home-logo"/>
<h1 class="title-name">Ječná Guesser</h1>
<p>From a picture, guess where you are in SPŠE Ječná.</p>

<a href="{{ path('app_leaderboard') }}" class="diff-btn">Leaderboard</a>

<div data-controller="difficulty" class="start-area">
    <div class="blurred-div">
        <button type="button" class="diff-btn diff-btn-selected"
               data-action="click->difficulty#select"
               data-difficulty-target="btn"
               data-value="easy">Easy</button>

        <button type="button" class="diff-btn"
               data-action="click->difficulty#select"
               data-difficulty-target="btn"
               data-value="medium">Medium</button>

        <button type="button" class="diff-btn"
               data-action="click->difficulty#select"
               data-difficulty-target="btn"
               data-value="hard">Hard</button>
    </div>

    <form method="POST" id="play-form">
        <input type="hidden" name="difficulty" data-difficulty-target="input" id="selected-difficulty" value="easy">
        <button type="submit" id="play-button" class="play-btn">PLAY</button>
    </form>
</div>

{% endblock %}
